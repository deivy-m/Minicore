<%- include('partials/header') %>

<div class="page-title">
    <h1>👤 Vendedores</h1>
    <p>Lista de vendedores registrados en el sistema.</p>
</div>

<div class="table-box">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            <% vendedores.forEach(function(v) { %>
                <tr>
                    <td><%= v.id %></td>
                    <td><strong><%= v.nombre %></strong></td>
                    <td><%= v.email %></td>
                    <td>
                        <span class="badge <%= v.activo ? 'badge-green' : 'badge-gray' %>">
                            <%= v.activo ? 'Activo' : 'Inactivo' %>
                        </span>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>

<a href="/comisiones" class="btn btn-primary">⚡ Calcular Comisiones</a>

<%- include('partials/footer') %>
